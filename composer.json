{
    "name": "otghcloud/aurora-access-adapter-opc",
    "description": "OPC adapter integration package for Access Control",
    "type": "library",
    "license": "MIT",
    "require": {
        "otghcloud/aurora-access-core": "^1.0",
        "techdock/opcua": "^0.3.0"
    },
    "autoload": {
        "psr-4": {
            "OTGH\\AccessControl\\OpcAdapter\\": "src/"
        }
